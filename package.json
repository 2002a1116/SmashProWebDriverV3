    "vuex": "^4.1.0",
    "y18n": "^5.0.8"
  },
  "devDependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "gh-pages": "^6.3.0",
    "naive-ui": "^2.41.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.4"
  }
